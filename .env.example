# Copy this file to .env and fill in ONE key (both have free tiers).
# .env is gitignored, so your key is never committed.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Or Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# MODEL=gemini-2.5-flash
# PROVIDER=mock        # run without any key (stub model, for testing the pipeline)
# PORT=8000
